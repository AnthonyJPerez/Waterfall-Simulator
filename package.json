{
  "name": "waterfall-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Ultra-realistic real-time simulator for small waterfalls, creeks and rapids (WebGPU)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/shot.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "tweakpane": "^4.0.5",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@tweakpane/core": "^2.0.5",
    "@webgpu/types": "^0.1.74",
    "playwright": "1.56.1",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
